{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user's mailbox profile and initialization state.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the user."
        },
        "email": {
          "type": "string",
          "description": "User's primary email address."
        },
        "displayName": {
          "type": "string",
          "description": "User's display name."
        },
        "mailboxSeeded": {
          "type": "boolean",
          "description": "Whether initial welcome messages and contacts have been provisioned."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp (FieldValue.serverTimestamp())."
        }
      },
      "required": ["userId", "email", "displayName", "mailboxSeeded", "createdAt", "updatedAt"]
    },
    "EmailMessage": {
      "title": "EmailMessage",
      "description": "An email message stored in a user's mailbox.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID."
        },
        "senderName": {
          "type": "string",
          "description": "Display name of the sender."
        },
        "senderEmail": {
          "type": "string",
          "description": "Email address of the sender."
        },
        "recipientEmail": {
          "type": "string",
          "description": "Email address of the recipient."
        },
        "subject": {
          "type": "string",
          "description": "Email subject line."
        },
        "body": {
          "type": "string",
          "description": "Plain-text body of the email."
        },
        "folder": {
          "type": "string",
          "enum": ["inbox", "sent", "drafts", "archive", "trash"],
          "description": "Mailbox folder containing this email."
        },
        "read": {
          "type": "boolean",
          "description": "Whether the email has been read."
        },
        "starred": {
          "type": "boolean",
          "description": "Whether the email is starred."
        },
        "sentAtMillis": {
          "type": "integer",
          "description": "Epoch milliseconds for display and chronological sorting."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "userId",
        "senderName",
        "senderEmail",
        "recipientEmail",
        "subject",
        "body",
        "folder",
        "read",
        "starred",
        "sentAtMillis",
        "createdAt",
        "updatedAt"
      ]
    },
    "Contact": {
      "title": "Contact",
      "description": "A saved contact with name and email address.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID."
        },
        "name": {
          "type": "string",
          "description": "Full name of the contact."
        },
        "email": {
          "type": "string",
          "description": "Email address of the contact."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp (FieldValue.serverTimestamp())."
        }
      },
      "required": ["userId", "name", "email", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User mailbox profile and initialization metadata."
    },
    "/users/{userId}/emails/{emailId}": {
      "schema": { "$ref": "#/entities/EmailMessage" },
      "description": "User-owned email messages across inbox, sent, drafts, archive, and trash."
    },
    "/users/{userId}/contacts/{contactId}": {
      "schema": { "$ref": "#/entities/Contact" },
      "description": "User-owned address book contacts."
    }
  }
}
