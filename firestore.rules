rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
             data.displayName is string && data.displayName.size() <= 120 &&
             data.mailboxSeeded is bool;
    }

    function isValidFolder(folder) {
      return folder in ['inbox', 'sent', 'drafts', 'archive', 'trash'];
    }

    function isValidEmail(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 120 &&
             data.senderEmail is string && data.senderEmail.size() >= 3 && data.senderEmail.size() <= 254 &&
             data.recipientEmail is string && data.recipientEmail.size() >= 0 && data.recipientEmail.size() <= 254 &&
             data.subject is string && data.subject.size() <= 250 &&
             data.body is string && data.body.size() <= 20000 &&
             data.folder is string && isValidFolder(data.folder) &&
             data.read is bool &&
             data.starred is bool &&
             data.sentAtMillis is int && data.sentAtMillis >= 0;
    }

    function isValidContact(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
             data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == userId &&
                       incoming().keys().hasAll(['userId', 'email', 'displayName', 'mailboxSeeded', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'email', 'displayName', 'mailboxSeeded', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'mailboxSeeded', 'updatedAt']);

      allow delete: if false;

      match /emails/{emailId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(emailId);

        allow create: if isOwner(userId) &&
                         isValidId(emailId) &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll(['userId', 'senderName', 'senderEmail', 'recipientEmail', 'subject', 'body', 'folder', 'read', 'starred', 'sentAtMillis', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'senderName', 'senderEmail', 'recipientEmail', 'subject', 'body', 'folder', 'read', 'starred', 'sentAtMillis', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidEmail(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(emailId) &&
                         isValidEmail(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         (
                           incoming().diff(existing()).affectedKeys().hasOnly(['read', 'updatedAt']) ||
                           incoming().diff(existing()).affectedKeys().hasOnly(['starred', 'updatedAt']) ||
                           incoming().diff(existing()).affectedKeys().hasOnly(['folder', 'updatedAt']) ||
                           incoming().diff(existing()).affectedKeys().hasOnly(['senderName', 'senderEmail', 'recipientEmail', 'subject', 'body', 'folder', 'read', 'starred', 'sentAtMillis', 'updatedAt'])
                         );

        allow delete: if isOwner(userId) && isValidId(emailId);
      }

      match /contacts/{contactId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(contactId);

        allow create: if isOwner(userId) &&
                         isValidId(contactId) &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll(['userId', 'name', 'email', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'name', 'email', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidContact(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(contactId) &&
                         isValidContact(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(contactId);
      }
    }
  }
}
