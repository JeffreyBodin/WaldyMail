{
  "name": "postbox-offline-mail",
  "version": "1.0.0",
  "description": "Offline-first Android email client (Postbox) with modular inline-loaded JS build, Windows bundle preparation, Docker export, and ADB CLI tools. No server or cloud hosting.",
  "private": false,
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./cli": "./bin/postbox.mjs",
    "./modules/*": "./lib/modules/*.mjs"
  },
  "bin": {
    "postbox": "./bin/postbox.mjs"
  },
  "files": [
    "README.md",
    "index.mjs",
    "lib/",
    "bin/",
    "app/",
    "gradle/",
    "windows/",
    "scripts/",
    "build.gradle.kts",
    "gradle.properties",
    "settings.gradle.kts",
    "Dockerfile",
    ".dockerignore"
  ],
  "scripts": {
    "info": "node ./lib/modules/MetadataInspector.mjs",
    "check:modules": "node --check ./index.mjs ./bin/postbox.mjs ./lib/modules/MetadataInspector.mjs ./lib/modules/GradleBuilder.mjs ./lib/modules/AdbInstaller.mjs ./lib/modules/DockerPackager.mjs ./lib/modules/WindowsBundleBuilder.mjs ./lib/modules/GitCommitHelper.mjs",
    "build:apk": "node ./lib/modules/GradleBuilder.mjs debug",
    "build:release-apk": "node ./lib/modules/GradleBuilder.mjs release",
    "build:aab": "node ./lib/modules/GradleBuilder.mjs bundle",
    "install:android": "node ./lib/modules/AdbInstaller.mjs android",
    "install:wsa": "node ./lib/modules/AdbInstaller.mjs wsa",
    "prepare:windows": "node ./lib/modules/WindowsBundleBuilder.mjs",
    "package:docker": "node ./lib/modules/DockerPackager.mjs export",
    "docker:commands": "node ./lib/modules/DockerPackager.mjs commands",
    "git:status": "node ./lib/modules/GitCommitHelper.mjs status",
    "pack:npm": "npm pack",
    "verify:toolkit": "node --test ./scripts/verify-toolkit.mjs",
    "test": "node ./lib/modules/GradleBuilder.mjs test"
  },
  "dependencies": {},
  "devDependencies": {},
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "keywords": [
    "android",
    "offline",
    "email",
    "apk",
    "aab",
    "windows-bundle",
    "google-play",
    "jetpack-compose"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "license": "Apache-2.0"
}
